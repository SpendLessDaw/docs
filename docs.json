{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SpendLess Daw Doc",
  "colors": {
    "primary": "#c462ff",
    "light": "#dea9ff",
    "dark": "#9929de"
  },
  "favicon": "/images/spendless-logo-v2.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "SpendLess Daw",
          "icon": "grid-2",
          "color": {
            "light": "#c462ff",
            "dark": "#c462ff"
          },
          "href": "https://spendlessdaw.app"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Customization",
            "hidden": true,
            "pages": [
              "essentials/settings",
              "essentials/navigation",
              "development",
              "quickstart",
              "index-copied-1"
            ]
          },
          {
            "group": "Writing content",
            "hidden": true,
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "hidden": true,
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      }
    ]
  },
  "logo": "/images/spendless-logo-v2.svg",
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/SpendLessDaw",
      "youtube": "https://www.youtube.com/@SpendLessDaw",
      "instagram": "https://www.instagram.com/spendlessdaw/",
      "x": "https://x.com/SpendLessDaw"
    }
  },
  "appearance": {
    "strict": true,
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "thumbnails": {
    "appearance": "dark"
  }
}
