{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SpendLess",
  "colors": {
    "primary": "#c462ff",
    "light": "#dea9ff",
    "dark": "#9929de"
  },
  "favicon": "/images/spendless-logo-v2.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "SpendLess Daw",
          "icon": "grid-2",
          "color": {
            "light": "#c462ff",
            "dark": "#c462ff"
          },
          "href": "https://spendlessdaw.app"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "en/welcome",
              "en/installation",
              "en/first-project"
            ]
          },
          {
            "group": "Your music",
            "pages": [
              "en/projects",
              "en/detection",
              "en/samples",
              "en/audio-previews"
            ]
          },
          {
            "group": "Protect and move your work",
            "pages": []
          },
          {
            "group": "Help",
            "pages": []
          }
        ]
      },
      {
        "language": "fr",
        "groups": [
          {
            "group": "Bien démarrer",
            "pages": []
          },
          {
            "group": "Votre musique",
            "pages": []
          },
          {
            "group": "Protéger et déplacer vos projets",
            "pages": []
          },
          {
            "group": "Aide",
            "pages": []
          }
        ]
      }
    ]
  },
  "logo": "/images/spendless-logo-v2.svg",
  "navbar": {
    "links": [
      {
        "href": "https://spendlessdaw.app",
        "label": "Back to website"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download SpendLess",
      "href": "https://spendlessdaw.app/#download"
    }
  },
  "contextual": {
    "options": [
    "copy"
  ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/SpendLessDaw",
      "youtube": "https://www.youtube.com/@SpendLessDaw",
      "instagram": "https://www.instagram.com/spendlessdaw/",
      "x": "https://x.com/SpendLessDaw"
    }
  },
  "appearance": {
    "strict": true,
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "description": "Spend less time managing files and more time making music. Learn to organize FL Studio projects, collect samples, make backups, and recover your work.",
  "search": {
    "prompt": "Search projects, samples, backups…"
  }
}
